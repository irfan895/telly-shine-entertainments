# Backend API URL (leave empty in local dev to use Vite proxy; set to your Render backend URL in production)
VITE_API_URL=

# Add the configuration values from your own Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Appwrite image storage (required for article image uploads)
VITE_APPWRITE_URL=
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_STORAGE_ID=
